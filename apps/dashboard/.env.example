# Codexa App frontend, read only by vite.config.ts for the dev and preview servers.
# Variables without the VITE_ prefix never reach browser code.
# Copy to .env to change a value. The production build ignores this file.

# The Codexa App host that npm run dev proxies OAuth API calls to.
CODEXA_HOST_URL=http://localhost:8000

# Ports for npm run dev and npm run preview. Codexa App and OAuth App use
# different defaults so both dev servers can run at once.
DEV_PORT=5173
PREVIEW_PORT=4173

# Browser settings, inlined into the bundle at build time. Rebuild after a change.
# Where OAuth serves its token and revocation endpoints.
# VITE_OAUTH_PATH=/oauth
# Where OAuth serves its versioned API, such as the session lookup.
# VITE_AUTH_API_PATH=/auth
# Sent as X-Auth-Version on versioned OAuth calls.
# VITE_AUTH_API_VERSION=1.0.0
# How long one request may take, in milliseconds.
# VITE_REQUEST_TIMEOUT_MS=15000
# Target of the "Powered by" link.
# VITE_BRAND_URL=https://github.com/Codexa-by-HQ
# Set to false to hide the theme toggle or the language picker.
# VITE_ENABLE_THEME_SWITCHER=true
# VITE_ENABLE_LANGUAGE_SWITCHER=true
