# Codexa App environment. Durations use s, m, h, d or w, such as 30s, 15m, 1d.
# Every value shown is the default unless marked as required.

# Codexa App host
# Where the host listens and what it connects to.

SERVER_HOSTNAME=localhost
SERVER_PORT=8000
# Public HTTPS origin when served behind a proxy. Leave unset for setup.
# PUBLIC_ORIGIN=https://example.com
# Read client addresses from X-Forwarded-For. Only behind your own proxy.
# TRUST_PROXY=false

# Required. MongoDB must be a replica set, because OAuth uses transactions.
DATABASE_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
DATABASE_NAME=codexa
# Required.
REDIS_URL=redis://127.0.0.1:6379

# OAuth, plugin id oauth

## Generated keys live in files under certs/, never here. Create them once with
## deno task keys:generate, and replace them with deno task keys:rotate.
## certs/README.md explains each file. The paths below are the defaults.
# OAUTH_ACCESS_TOKEN_KEY_FILE=certs/access-token.key
# OAUTH_MFA_KEYS_DIR=certs/mfa
# OAUTH_OIDC_SIGNING_KEY_FILE=certs/oidc-signing.jwk.json
OAUTH_ACCESS_TOKEN_ISSUER=http://localhost:8000
OAUTH_ACCESS_TOKEN_AUDIENCE=codexa

## Credential lifetimes. Setup reads these too.
OAUTH_ACCESS_TOKEN_TTL=15m
OAUTH_SESSION_TTL=1d
OAUTH_REFRESH_TOKEN_TTL=30d

## Authorization flow
OAUTH_TRANSACTION_TTL=5m
OAUTH_AUTHORIZATION_CODE_TTL=1m
OAUTH_CSRF_TTL=5m

## Security
OAUTH_OTP_TTL=5m
OAUTH_RATE_LIMIT_WINDOW=5m
OAUTH_PASSWORD_LOGIN_MAX_ATTEMPTS=5

## Permissions. Comma separated app ids trusted to issue across apps.
OAUTH_TRUSTED_CROSS_APP_ISSUER_APP_IDS=
# How deep accounts nest below a root account, which is level 0.
# OAUTH_ACCOUNT_MAX_DEPTH=5

## Email delivery. Off until OAUTH_SMTP_HOST is set.
# OAUTH_SMTP_HOST=smtp.example.com
# OAUTH_SMTP_PORT=587
# OAUTH_SMTP_SECURE=false
# OAUTH_SMTP_REQUIRE_TLS=true
# OAUTH_SMTP_FROM=Codexa <no-reply@example.com>
# OAUTH_SMTP_USERNAME=
# OAUTH_SMTP_PASSWORD=
# OAUTH_SMTP_CONNECTION_TIMEOUT=10s
# OAUTH_SMTP_GREETING_TIMEOUT=10s
# OAUTH_SMTP_SOCKET_TIMEOUT=30s

# OAuth App, plugin id oauth-app

# Must match the Vite base of the OAuth App build.
# OAUTH_APP_MOUNT_PATH=/auth
# OAUTH_APP_ASSETS_URL=file:///absolute/path/to/dist/

# Optional OAuth plugins. Each one installs only when its settings are present,
# and the host logs why one is off.

# Media, plugin id media. Uploads such as profile pictures go from the browser
# straight to the storage provider with a signed, short lived upload, and media
# checks every stored file before anything uses it. Off while
# MEDIA_STORAGE_PROVIDER is unset, and then nothing can be uploaded. Values are
# in the Cloudinary console. What may be uploaded is set in
# core/config/media.config.ts.
# MEDIA_STORAGE_PROVIDER=cloudinary
# MEDIA_CLOUDINARY_CLOUD_NAME=
# MEDIA_CLOUDINARY_API_KEY=
# MEDIA_CLOUDINARY_API_SECRET=

# OAuth MFA, plugin id oauth-mfa. Off while OAUTH_MFA_KEYS_DIR holds no key.
# OAUTH_MFA_ISSUER=Codexa

# OAuth Passkey, plugin id oauth-passkey. On when the public origin is localhost
# or an HTTPS domain. WebAuthn rejects an IP origin such as http://127.0.0.1:8000.
# OAUTH_PASSKEY_RP_NAME=Codexa

# OAuth Magic Link, plugin id oauth-magic-link. On when email delivery is set.
# OAUTH_MAGIC_LINK_TTL=5m

# OAuth SSO, plugin id oauth-sso. Each provider turns on when its provider ID,
# client ID and client secret are all set. The provider ID is a fixed ObjectId,
# because the redirect URI registered at the provider is
# <origin>/oauth/sso/callback/<provider id>. Generate one per provider, once:
## node -e "console.log(require('crypto').randomBytes(12).toString('hex'))"
# ALLOW_REGISTRATION lets a new person sign up through the provider.
# LINK_VERIFIED_EMAIL signs a person in to the existing user with the same
# email, only when both the provider and OAuth have verified that email.
# Google: console.cloud.google.com, Credentials, OAuth client ID of type Web application
# OAUTH_SSO_GOOGLE_PROVIDER_ID=
# OAUTH_SSO_GOOGLE_CLIENT_ID=
# OAUTH_SSO_GOOGLE_CLIENT_SECRET=
# OAUTH_SSO_GOOGLE_ALLOW_REGISTRATION=true
# OAUTH_SSO_GOOGLE_LINK_VERIFIED_EMAIL=true
# GitHub: github.com/settings/developers, OAuth Apps, with PKCE allowed
# OAUTH_SSO_GITHUB_PROVIDER_ID=
# OAUTH_SSO_GITHUB_CLIENT_ID=
# OAUTH_SSO_GITHUB_CLIENT_SECRET=
# OAUTH_SSO_GITHUB_ALLOW_REGISTRATION=true
# OAUTH_SSO_GITHUB_LINK_VERIFIED_EMAIL=true
# Facebook: developers.facebook.com, an app with Facebook Login
# OAUTH_SSO_FACEBOOK_PROVIDER_ID=
# OAUTH_SSO_FACEBOOK_CLIENT_ID=
# OAUTH_SSO_FACEBOOK_CLIENT_SECRET=
# OAUTH_SSO_FACEBOOK_ALLOW_REGISTRATION=true
# OAUTH_SSO_FACEBOOK_LINK_VERIFIED_EMAIL=true

# OAuth OIDC, plugin id oauth-oidc. Off while OAUTH_OIDC_SIGNING_KEY_FILE is missing.
# OAUTH_OIDC_ID_TOKEN_TTL=5m

# OAuth Device, plugin id oauth-device. Always on.
# OAUTH_DEVICE_CODE_TTL=10m
# OAUTH_DEVICE_POLLING_INTERVAL=5s

# Codexa App, plugin id codexa-app

# Public client from setup that the Codexa App frontend signs in with.
# Sign in stays off while it is unset. It mounts at /app, set in config/app.config.ts.
CODEXA_APP_OAUTH_CLIENT_ID=

# Tests, read only by deno task test

# Public client from setup. The flow test is skipped while this is unset.
# OAUTH_TEST_CLIENT_ID=
# OAUTH_TEST_REDIRECT_URI=http://localhost:8000/app/callback
# The platform administrator from setup. Tests sign in as this person to
# write the policies they need, as the administrator would in Settings.
# OAUTH_TEST_ADMIN_USERNAME=
# OAUTH_TEST_ADMIN_PASSWORD=
# A separate port, so tests can run while the dev host is up.
# OAUTH_TEST_PORT=8199
# When set, the browser test saves every screen here as a PNG.
# E2E_SCREENSHOT_DIR=tests/e2e/screenshots
# Browser for the e2e test. An installed Chrome or Edge is used when unset.
# E2E_BROWSER_PATH=
