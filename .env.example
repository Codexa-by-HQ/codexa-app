# Codexa App environment. Durations use s, m, h, d or w, such as 30s, 15m, 1d.
# Every value shown is the default unless marked as required.

# Codexa App host
# Where the host listens and what it connects to.

SERVER_HOSTNAME=127.0.0.1
SERVER_PORT=8000
# Public HTTPS origin when served behind a proxy. Leave unset for setup.
# PUBLIC_ORIGIN=https://example.com

# Required. MongoDB must be a replica set, because OAuth uses transactions.
DATABASE_URL=mongodb://127.0.0.1:27017/?replicaSet=rs0
DATABASE_NAME=codexa
# Required.
REDIS_URL=redis://127.0.0.1:6379

# OAuth, plugin id oauth

## Access token signing. Required, at least 32 random characters. Rotating the secret signs every user out.
OAUTH_ACCESS_TOKEN_SIGNING_SECRET=
OAUTH_ACCESS_TOKEN_ISSUER=http://127.0.0.1:8000
OAUTH_ACCESS_TOKEN_AUDIENCE=codexa

## Credential lifetimes. Setup reads these too.
OAUTH_ACCESS_TOKEN_TTL=15m
OAUTH_SESSION_TTL=1d
OAUTH_REFRESH_TOKEN_TTL=30d

## Authorization flow
OAUTH_TRANSACTION_TTL=5m
OAUTH_AUTHORIZATION_CODE_TTL=1m
OAUTH_CSRF_TTL=5m

## Security
OAUTH_OTP_TTL=5m
OAUTH_RATE_LIMIT_WINDOW=5m
OAUTH_PASSWORD_LOGIN_MAX_ATTEMPTS=5

## Permissions. Comma separated app ids trusted to issue across apps.
OAUTH_TRUSTED_CROSS_APP_ISSUER_APP_IDS=

## Email delivery. Off until OAUTH_SMTP_HOST is set.
# OAUTH_SMTP_HOST=smtp.example.com
# OAUTH_SMTP_PORT=587
# OAUTH_SMTP_SECURE=false
# OAUTH_SMTP_REQUIRE_TLS=true
# OAUTH_SMTP_FROM=Codexa <no-reply@example.com>
# OAUTH_SMTP_USERNAME=
# OAUTH_SMTP_PASSWORD=
# OAUTH_SMTP_CONNECTION_TIMEOUT=10s
# OAUTH_SMTP_GREETING_TIMEOUT=10s
# OAUTH_SMTP_SOCKET_TIMEOUT=30s

# OAuth App, plugin id oauth-app

# Must match the Vite base of the OAuth App build.
# OAUTH_APP_MOUNT_PATH=/auth
# OAUTH_APP_ASSETS_URL=file:///absolute/path/to/dist/

# Codexa App, plugin id codexa-app

# Nothing to configure yet. It mounts at /app, set in config/app.config.ts.
