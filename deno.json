{
	"name": "@codexa/codexa-app",
	"version": "1.0.0",
	"description": "Codexa App host and assembler. Installs the official OAuth plugins, serves the OAuth sign in UI and the product dashboard, and hosts official plugin interfaces.",
	"license": "MIT",
	"author": "Hamza Qureshi",
	"repository": {
		"type": "git",
		"author": "Codexa-by-HQ",
		"url": "https://github.com/Codexa-by-HQ/codexa-app.git"
	},
	"publish": false,
	"fmt": {
		"useTabs": true,
		"lineWidth": 80,
		"indentWidth": 4,
		"semiColons": true,
		"singleQuote": true,
		"proseWrap": "preserve",
		"include": [
			"./"
		],
		"exclude": [
			"node_modules/",
			"apps/",
			"binaries/"
		]
	},
	"lint": {
		"include": [
			"./"
		],
		"exclude": [
			"node_modules/",
			"apps/",
			"binaries/"
		],
		"rules": {
			"tags": [
				"recommended"
			],
			"include": [
				"ban-untagged-todo",
				"no-explicit-any",
				"no-non-null-assertion",
				"prefer-as-const",
				"no-unsafe-finally",
				"ban-untagged-ignore",
				"eqeqeq",
				"camelcase",
				"no-eval"
			],
			"exclude": [
				"no-unused-vars",
				"no-console",
				"require-await"
			]
		}
	},
	"compilerOptions": {
		"lib": [
			"deno.window",
			"deno.unstable",
			"deno.ns"
		],
		"strict": true
	},
	"exclude": [
		"node_modules/"
	],
	"tasks": {
		"dev": "deno run --watch --allow-net --allow-read --allow-env --allow-sys main.ts",
		"setup": "deno run --allow-net --allow-read --allow-env --allow-sys core/scripts/setup.ts",
		"plugins:local": "deno run --allow-read --allow-write --allow-run=deno,git core/scripts/install-local.ts",
		"keys:generate": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys core/scripts/keys.ts generate",
		"keys:rotate": "deno run --allow-read --allow-write --allow-env --allow-net --allow-sys core/scripts/keys.ts rotate",
		"test": "deno test --allow-net --allow-read --allow-write --allow-env --allow-sys tests/",
		"test:e2e": "deno test -A tests/e2e/signin.e2e.ts tests/e2e/branding.e2e.ts tests/e2e/methods.e2e.ts tests/e2e/session.e2e.ts tests/e2e/expired.e2e.ts tests/e2e/recovery.e2e.ts tests/e2e/shell.e2e.ts tests/e2e/account.e2e.ts tests/e2e/sso.e2e.ts tests/e2e/manage.e2e.ts tests/e2e/tenant.e2e.ts tests/e2e/developers.e2e.ts tests/e2e/device.e2e.ts tests/e2e/providers.e2e.ts tests/e2e/invite.e2e.ts"
	},
	"exports": {
		".": "./plugin.ts"
	},
	"imports": {
		"@codexa/http": "jsr:@codexa/http@^2.1.2",
		"@codexa/cli": "jsr:@codexa/cli@^1.2.0",
		"@codexa/core/config": "jsr:@codexa/core@2.1.0/config",
		"@codexa/core/crypto": "jsr:@codexa/core@2.1.0/crypto",
		"@codexa/core/storage": "jsr:@codexa/core@2.1.0/storage",
		"@codexa/core/logger": "jsr:@codexa/core@2.1.0/logger",
		"@codexa/core/providers/mongodb": "jsr:@codexa/core@2.1.0/providers/mongodb",
		"@codexa/core/providers/zod": "jsr:@codexa/core@2.1.0/providers/zod",
		"@codexa/core/ttl": "jsr:@codexa/core@2.1.0/ttl",
		"nodemailer": "npm:nodemailer@^10.6.0",
		"@codexa/core/providers/dotenv": "jsr:@codexa/core@2.1.0/providers/dotenv",
		"@std/assert": "jsr:@std/assert@^1.0.0",
		"playwright-core": "npm:playwright-core@^1.65.1"
	},
	"minimumDependencyAge": "0",
	"workspace": [
		"./plugins/oauth-passkey",
		"./plugins/oauth-magic-link",
		"./plugins/oauth",
		"./plugins/oauth-mfa",
		"./plugins/oauth-sso",
		"./plugins/oauth-oidc",
		"./plugins/oauth-device",
		"./plugins/oauth-app"
	]
}
